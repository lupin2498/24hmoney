# ===== Bắt buộc để có tóm tắt & phân tích =====
# API key của Anthropic (tạo tại https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# ===== Máy chủ web =====
PORT=3000
# 0.0.0.0 để điện thoại cùng mạng Wi-Fi truy cập được; 127.0.0.1 nếu chỉ dùng trên máy này
HOST=0.0.0.0
# Đặt mã này nếu đưa ứng dụng lên Internet: các thao tác tốn chi phí (quét, phân tích, lập bản tin) sẽ cần mã
ADMIN_TOKEN=
# Thư mục lưu dữ liệu và số ngày giữ lại
DATA_DIR=data
RETENTION_DAYS=30

# ===== AI (Claude) =====
CLAUDE_MODEL=claude-opus-5-5
# Mức effort: low | medium | high | xhigh | max
ARTICLE_EFFORT=medium
DIGEST_EFFORT=high
# Tự chuyển sang model dự phòng khi model chính từ chối vì chính sách an toàn (1 = bật)
CLAUDE_FALLBACKS=1
# Số bài phân tích song song và giới hạn số bài tự động phân tích mỗi ngày
AI_CONCURRENCY=2
AI_DAILY_ARTICLE_LIMIT=150
# Chỉ tự động phân tích bài đăng trong khoảng này (giờ)
AUTO_ANALYZE_MAX_AGE_HOURS=36
# Đặt 0 để tắt hẳn AI (chỉ thu thập tin)
AI_ENABLED=1

# ===== Bản tin chuyên gia =====
# Các mốc giờ (giờ Việt Nam) tự lập/cập nhật bản tin trong ngày
DIGEST_TIMES=08:00,12:00,16:00,20:00
DIGEST_MIN_ARTICLES=5
DIGEST_MAX_ARTICLES=120

# ===== Thu thập tin từ 24HMoney =====
SOURCE_BASE_URL=https://24hmoney.vn
# Các trang danh sách tin dùng để phát hiện bài mới (phân cách bằng dấu phẩy)
SOURCE_PAGES=/,/indices/vn-index/tin-tuc
CRAWL_INTERVAL_MINUTES=20
MAX_NEW_ARTICLES_PER_CRAWL=40
# Bỏ qua bài đăng cũ hơn số giờ này
MAX_ARTICLE_AGE_HOURS=48
USE_SITEMAPS=1
CRAWL_CONCURRENCY=3
CRAWL_DELAY_MS=300
HTTP_TIMEOUT_MS=20000
# Mẫu đường dẫn bài viết và trang chuyên mục (biểu thức chính quy)
# ARTICLE_PATH_PATTERN=/news/[a-z0-9][a-z0-9-]*\.html
# LISTING_PATH_PATTERN=/(?:tin-tuc|news-category|chuyen-muc)(?:/[a-z0-9-]*)?
